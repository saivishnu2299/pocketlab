#!/bin/sh
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
if ! command -v python3 >/dev/null 2>&1; then
    printf 'PocketLAB requires Python 3.9+ (3.12+ to build mini apps). See docs/INSTALL.md.\n' >&2
    exit 1
fi
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,9) else 1)'; then
    printf 'Use Python 3.9 or newer (3.12+ to build mini apps). See docs/INSTALL.md.\n' >&2
    exit 1
fi
exec python3 "$ROOT/tools/pocketlab.py" "$@"
